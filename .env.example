# Token used only by this script. Never upload it as a repository secret.
GITHUB_TOKEN=

# Shared AWS credentials (temporary credentials require AWS_SESSION_TOKEN).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1

# Token used by the apps workflows to push to the GitOps repository.
GITOPS_TOKEN=

# GitOps runtime configuration.
AUTH_DATABASE_URL=
FLAG_DATABASE_URL=
TARGETING_DATABASE_URL=
REDIS_URL=
MASTER_KEY=
AWS_DYNAMODB_TABLE=
AWS_SQS_URL=
EKS_CLUSTER_NAME=

# Self-healing (GitHub App). SELF_HEALING_ENABLED must stay false until restarts are authorized.
SELF_HEALING_ENABLED=false
SELF_HEALING_APP_ID=
SELF_HEALING_INSTALLATION_ID=
# Multiline PEM: keep it inside double quotes, including the BEGIN and END lines.
# SELF_HEALING_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
# <key body>
# -----END RSA PRIVATE KEY-----"
SELF_HEALING_APP_PRIVATE_KEY=

# Observability notifications (Terraform).
DISCORD_WEBHOOK_URL=
PAGERDUTY_INTEGRATION_KEY=

# Terraform configuration. Keep JSON on one line inside single quotes.
TF_VAR_RDS_INSTANCE_PASSWORDS=
# Example format (replace every password before use):
# Keys must match rds.instances: auth, targeting, flags.
# TF_VAR_RDS_INSTANCE_PASSWORDS='{"auth":"REPLACE_AUTH","targeting":"REPLACE_TARGETING","flags":"REPLACE_FLAGS"}'
